# 1. 安装依赖
pip install typer openai praw requests beautifulsoup4 rich

# 2. 配置 API keys
cp .env.example .env
# 编辑 .env 填入你的 OpenAI API key

# 3. 测试运行
python -m customer_finder.cli analyze "我做了一个帮开发者自动生成 API 文档的工具"

# 4. 检查输出
# 应该看到客户画像、渠道清单、联系模板