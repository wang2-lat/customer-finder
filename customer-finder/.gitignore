# 1. 安装依赖
cd customer-finder
pip install -e .

# 2. 配置 API（复制 .env.example 为 .env 并填写）
cp .env.example .env

# 3. 测试搜索
customer-finder search "project management" --platforms reddit --limit 10

# 4. 生成话术
customer-finder generate-outreach customers.json --product "我的产品"